generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Block {
  id                         String   @id
  blockerId                  String
  blockedId                  String
  createdAt                  DateTime @default(now())
  User_Block_blockedIdToUser User     @relation("Block_blockedIdToUser", fields: [blockedId], references: [id], onDelete: Cascade)
  User_Block_blockerIdToUser User     @relation("Block_blockerIdToUser", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId])
}

model CallSession {
  id                             String    @id
  channelName                    String    @unique
  userAId                        String
  userBId                        String
  status                         String    @default("active")
  startedAt                      DateTime  @default(now())
  endedAt                        DateTime?
  User_CallSession_userAIdToUser User      @relation("CallSession_userAIdToUser", fields: [userAId], references: [id])
  User_CallSession_userBIdToUser User      @relation("CallSession_userBIdToUser", fields: [userBId], references: [id])
}

model Match {
  id                       String   @id
  userAId                  String
  userBId                  String
  createdAt                DateTime @default(now())
  User_Match_userAIdToUser User     @relation("Match_userAIdToUser", fields: [userAId], references: [id], onDelete: Cascade)
  User_Match_userBIdToUser User     @relation("Match_userBIdToUser", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Swipe {
  id                          String      @id
  fromUserId                  String
  toUserId                    String
  action                      SwipeAction
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime
  User_Swipe_fromUserIdToUser User        @relation("Swipe_fromUserIdToUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  User_Swipe_toUserIdToUser   User        @relation("Swipe_toUserIdToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model User {
  id                                    String        @id
  phoneNumber                           String        @unique
  email                                 String?       @unique
  name                                  String
  birthday                              DateTime
  gender                                String
  location                              Json?
  lookingFor                            String[]
  aboutMe                               String?
  startConversation                     String?
  comfortableWith                       String?
  customQuestion                        String?
  customAnswer                          String?
  createdAt                             DateTime      @default(now())
  updatedAt                             DateTime
  Block_Block_blockedIdToUser           Block[]       @relation("Block_blockedIdToUser")
  Block_Block_blockerIdToUser           Block[]       @relation("Block_blockerIdToUser")
  CallSession_CallSession_userAIdToUser CallSession[] @relation("CallSession_userAIdToUser")
  CallSession_CallSession_userBIdToUser CallSession[] @relation("CallSession_userBIdToUser")
  Match_Match_userAIdToUser             Match[]       @relation("Match_userAIdToUser")
  Match_Match_userBIdToUser             Match[]       @relation("Match_userBIdToUser")
  Swipe_Swipe_fromUserIdToUser          Swipe[]       @relation("Swipe_fromUserIdToUser")
  Swipe_Swipe_toUserIdToUser            Swipe[]       @relation("Swipe_toUserIdToUser")
  UserMedia                             UserMedia[]
}

model UserMedia {
  id        String            @id
  userId    String
  kind      MediaKind
  objectKey String            @unique
  mimeType  String
  publicUrl String?
  sortOrder Int               @default(0)
  metadata  Json?
  status    MediaUploadStatus @default(PENDING)
  createdAt DateTime          @default(now())
  User      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

enum MediaKind {
  PROFILE_PHOTO
  INTRO_VIDEO
  ID_DOCUMENT
  VERIFICATION_PHOTO
}

enum MediaUploadStatus {
  PENDING
  CONFIRMED
}

enum SwipeAction {
  LIKE
  PASS
  SUPER_LIKE
}

// --- Admin-only models (safe to add alongside existing main-app tables) ---

enum AdminRole {
  super_admin
  admin
  moderator
  support
  developer
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum ReportType {
  user
  media
  message
  profile
}

enum VerificationStatus {
  pending
  approved
  rejected
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(admin)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Report {
  id         String       @id @default(cuid())
  type       ReportType
  status     ReportStatus @default(open)
  reporterId String
  targetId   String
  reason     String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([type])
}

model Verification {
  id          String             @id @default(cuid())
  userId      String
  mediaKey    String
  status      VerificationStatus @default(pending)
  submittedAt DateTime           @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([status])
  @@index([userId])
}
