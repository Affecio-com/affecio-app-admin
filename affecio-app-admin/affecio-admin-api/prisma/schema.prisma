generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserAccountStatus {
  active
  warned
  restricted
  shadowbanned
  suspended
  banned
}

model UserAdminMeta {
  userId          String            @id
  status          UserAccountStatus @default(active)
  adminNotes      String?
  statusReason    String?
  statusChangedAt DateTime?
  statusChangedBy String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Block {
  id                         String   @id
  blockerId                  String
  blockedId                  String
  createdAt                  DateTime @default(now())
  User_Block_blockedIdToUser User     @relation("Block_blockedIdToUser", fields: [blockedId], references: [id], onDelete: Cascade)
  User_Block_blockerIdToUser User     @relation("Block_blockerIdToUser", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId])
}

model CallSession {
  id                             String    @id
  channelName                    String    @unique
  userAId                        String
  userBId                        String
  status                         String    @default("active")
  startedAt                      DateTime  @default(now())
  endedAt                        DateTime?
  User_CallSession_userAIdToUser User      @relation("CallSession_userAIdToUser", fields: [userAId], references: [id])
  User_CallSession_userBIdToUser User      @relation("CallSession_userBIdToUser", fields: [userBId], references: [id])
}

model Match {
  id                       String   @id
  userAId                  String
  userBId                  String
  createdAt                DateTime @default(now())
  User_Match_userAIdToUser User     @relation("Match_userAIdToUser", fields: [userAId], references: [id], onDelete: Cascade)
  User_Match_userBIdToUser User     @relation("Match_userBIdToUser", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Swipe {
  id                          String      @id
  fromUserId                  String
  toUserId                    String
  action                      SwipeAction
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime
  User_Swipe_fromUserIdToUser User        @relation("Swipe_fromUserIdToUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  User_Swipe_toUserIdToUser   User        @relation("Swipe_toUserIdToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model User {
  id                                    String        @id
  phoneNumber                           String        @unique
  email                                 String?       @unique
  name                                  String
  birthday                              DateTime
  gender                                String
  location                              Json?
  lookingFor                            String[]
  aboutMe                               String?
  startConversation                     String?
  comfortableWith                       String?
  customQuestion                        String?
  customAnswer                          String?
  createdAt                             DateTime      @default(now())
  updatedAt                             DateTime
  Block_Block_blockedIdToUser           Block[]       @relation("Block_blockedIdToUser")
  Block_Block_blockerIdToUser           Block[]       @relation("Block_blockerIdToUser")
  CallSession_CallSession_userAIdToUser CallSession[] @relation("CallSession_userAIdToUser")
  CallSession_CallSession_userBIdToUser CallSession[] @relation("CallSession_userBIdToUser")
  Match_Match_userAIdToUser             Match[]       @relation("Match_userAIdToUser")
  Match_Match_userBIdToUser             Match[]       @relation("Match_userBIdToUser")
  Swipe_Swipe_fromUserIdToUser          Swipe[]       @relation("Swipe_fromUserIdToUser")
  Swipe_Swipe_toUserIdToUser            Swipe[]       @relation("Swipe_toUserIdToUser")
  UserMedia                             UserMedia[]
}

model UserMedia {
  id        String            @id
  userId    String
  kind      MediaKind
  objectKey String            @unique
  mimeType  String
  publicUrl String?
  sortOrder Int               @default(0)
  metadata  Json?
  status    MediaUploadStatus @default(PENDING)
  createdAt DateTime          @default(now())
  User      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

enum MediaKind {
  PROFILE_PHOTO
  INTRO_VIDEO
  ID_DOCUMENT
  VERIFICATION_PHOTO
}

enum MediaUploadStatus {
  PENDING
  CONFIRMED
  HIDDEN
}

enum SwipeAction {
  LIKE
  PASS
  SUPER_LIKE
}

// --- Admin-only models (safe to add alongside existing main-app tables) ---

enum AdminRole {
  super_admin
  admin
  moderator
  support
  developer
  marketing
}

enum PushCampaignStatus {
  draft
  sent
  failed
  partial
}

enum PushAudience {
  all
  new_users
  active_users
}

enum ReportContext {
  VIDEO_CALL
  PROFILE
  OTHER
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum ReportType {
  user
  media
  message
  profile
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum SupportTicketStatus {
  open
  in_progress
  waiting_on_user
  escalated
  resolved
  closed
}

enum SupportTicketCategory {
  account
  safety
  matching
  billing
  technical
  other
}

enum SupportTicketPriority {
  low
  medium
  high
  urgent
}

enum SupportMessageAuthor {
  user
  agent
  system
  internal
}

enum SupportEscalationTarget {
  admin
  developer
}

enum SupportEscalationStatus {
  open
  acknowledged
  resolved
}

model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        AdminRole
  tokenHash   String    @unique
  expiresAt   DateTime
  invitedById String
  invitedBy   AdminUser @relation("AdminInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model AdminUser {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String
  name                 String
  role                 AdminRole           @default(admin)
  mfaEnabled           Boolean             @default(false)
  mfaSecret            String?
  lastLoginAt          DateTime?
  lastActivityAt       DateTime?
  tokenVersion         Int                 @default(0)
  failedLoginCount     Int                 @default(0)
  lockedUntil          DateTime?
  disabledAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  invitesSent          AdminInvite[]       @relation("AdminInvitesSent")
  auditLogs            AuditLog[]
  pushCampaigns        PushCampaign[]
  assignedTickets      SupportTicket[]     @relation("TicketAssignee")
  createdTickets       SupportTicket[]     @relation("TicketCreatedBy")
  supportMessages      SupportMessage[]
  escalationsCreated   SupportEscalation[] @relation("EscalationCreatedBy")
  escalationsHandled   SupportEscalation[] @relation("EscalationHandledBy")
  userAdminActions     UserAdminAction[]
  serviceHealthUpdates ServiceHealthEvent[]
}

model SupportTicket {
  id            String                 @id @default(cuid())
  userId        String
  subject       String
  category      SupportTicketCategory  @default(account)
  priority      SupportTicketPriority  @default(medium)
  status        SupportTicketStatus    @default(open)
  assignedToId  String?
  assignedTo    AdminUser?             @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdById   String?
  createdBy     AdminUser?             @relation("TicketCreatedBy", fields: [createdById], references: [id])
  resolvedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  messages      SupportMessage[]
  escalations   SupportEscalation[]

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model SupportMessage {
  id         String               @id @default(cuid())
  ticketId   String
  ticket     SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType SupportMessageAuthor
  adminId    String?
  admin      AdminUser?           @relation(fields: [adminId], references: [id])
  body       String
  createdAt  DateTime             @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model SupportEscalation {
  id          String                   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  target      SupportEscalationTarget
  reason      String
  status      SupportEscalationStatus  @default(open)
  createdById String
  createdBy   AdminUser                @relation("EscalationCreatedBy", fields: [createdById], references: [id])
  handledById String?
  handledBy   AdminUser?               @relation("EscalationHandledBy", fields: [handledById], references: [id])
  notes       String?
  createdAt   DateTime                 @default(now())
  resolvedAt  DateTime?

  @@index([ticketId])
  @@index([target])
  @@index([status])
}

enum UserAdminActionType {
  note
  warn
  restrict
  shadowban
  suspend
  ban
  restore
  hide_media
  unhide_media
  edit_profile
}

model UserAdminAction {
  id        String               @id @default(cuid())
  userId    String
  adminId   String
  admin     AdminUser            @relation(fields: [adminId], references: [id])
  action    UserAdminActionType
  reason    String?
  createdAt DateTime             @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PushDeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PushCampaign {
  id          String             @id @default(cuid())
  title       String
  body        String
  audience    PushAudience       @default(all)
  status      PushCampaignStatus @default(draft)
  sentCount   Int                @default(0)
  failedCount Int                @default(0)
  targetCount Int                @default(0)
  createdById String
  createdBy   AdminUser          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  sentAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Report {
  id            String        @id @default(cuid())
  reporterId    String
  reportedId    String
  reason        String
  context       ReportContext @default(OTHER)
  callSessionId String?
  status        ReportStatus  @default(open)
  type          ReportType    @default(user)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([reporterId])
  @@index([reportedId])
  @@index([callSessionId])
  @@index([status])
  @@index([type])
}

model Verification {
  id          String             @id @default(cuid())
  userId      String
  mediaKey    String
  status      VerificationStatus @default(pending)
  submittedAt DateTime           @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([status])
  @@index([userId])
}

enum ServiceHealthStatus {
  operational
  degraded
  partial_outage
  major_outage
  maintenance
}

model ServiceHealthComponent {
  id          String              @id
  groupId     String
  groupName   String
  name        String
  status      ServiceHealthStatus @default(operational)
  description String?
  sortOrder   Int                 @default(0)
  updatedAt   DateTime            @updatedAt
  events      ServiceHealthEvent[]

  @@index([groupId])
}

model ServiceHealthEvent {
  id          String                 @id @default(cuid())
  componentId String
  component   ServiceHealthComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  status      ServiceHealthStatus
  message     String
  createdById String?
  createdBy   AdminUser?             @relation(fields: [createdById], references: [id])
  createdAt   DateTime               @default(now())

  @@index([componentId])
  @@index([createdAt])
}
