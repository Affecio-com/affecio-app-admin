# Server (Vercel/Render set PORT; local default 4001)
PORT=4001
NODE_ENV=development
# Extra browser origins (optional). On Vercel, VERCEL_URL is added automatically in code.
# Local split dev:
CORS_ORIGIN=http://localhost:3000

# Shared PostgreSQL (same as main Affecio API — do NOT reset)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/postgres?schema=public

# Admin auth (separate from mobile user JWT)
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=1h
ADMIN_REFRESH_SECRET=change-me-admin-refresh-secret

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (private media presigned URLs)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=affecio-private

# FCM (optional — push notifications to mobile app)
FCM_SERVER_KEY=
