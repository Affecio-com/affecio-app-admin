# Server (Render sets PORT automatically; local default 4001)
PORT=4001
NODE_ENV=development
# Comma-separated browser origins allowed to call this API.
# Local: http://localhost:3000
# Render (prod): https://<your-vercel-domain>  (*.vercel.app previews are allowed automatically)
CORS_ORIGIN=http://localhost:3000

# Shared PostgreSQL (same as main Affecio API — do NOT reset)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/postgres?schema=public

# Admin auth (separate from mobile user JWT)
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=1h
ADMIN_REFRESH_SECRET=change-me-admin-refresh-secret

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (private media presigned URLs)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=affecio-private

# FCM (optional — push notifications to mobile app)
FCM_SERVER_KEY=

# Admin team invites (email + accept link)
ADMIN_PORTAL_URL=http://localhost:3000
EMAIL_FROM=Affecio Admin <no-reply@affecio.com>
EMAIL_INVITE_ORG_NAME=Affecio Pvt Ltd
EMAIL_INVITE_PROJECT_NAME=Affecio Admin Console
INVITE_TTL_DAYS=7
# SMTP (required in production to send invites; omit locally to log link in API console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# SMTP_USER=
# SMTP_PASS=
