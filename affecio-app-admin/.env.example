# Local split dev (Next :3000 + API :4001):
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4001/api

# Vercel production: do NOT set NEXT_PUBLIC_ADMIN_API_URL — UI uses same-origin /api
# (see vercel.json rewrites). Do not set ADMIN_API_URL manually; Vercel injects it on the app service.

NEXT_PUBLIC_APP_NAME=Affecio Admin
